# Flask Server Configuration
FLASK_APP=backend/app.py
FLASK_ENV=development
FLASK_DEBUG=1
PORT=5000
SECRET_KEY=change-this-to-a-secure-random-key-in-production

# MySQL Database Configuration
DB_HOST=localhost
DB_PORT=3306
DB_NAME=bank_ddos
DB_USER=root
DB_PASSWORD=mysql@1001
DATABASE_URL=mysql+pymysql://root:mysql@1001@localhost:3306/bank_ddos

# Network Interface & Monitoring Settings
NETWORK_INTERFACE=eth0
MONITOR_PROMISCUOUS=False
# Comma-separated list of protected/monitored subnets (e.g. 192.168.1.0/24 or 10.0.0.0/8,172.16.0.0/16)
# If left unset/empty, Inbound defaults to 0.0 (safe unconfigured behavior)
MONITORED_SUBNET=10.15.20.0/24

# Feature Audit Log (opt-in — records exact ML feature vectors for each live-analyzed flow)
# Enable only during debugging or demo sessions. Never enable in CI or automated test runs.
# Records: flow metadata (IPs, ports, timing), 20 feature values, prediction, confidence.
# No packet payloads, application-layer content, or credentials are stored.
# The logs/ directory is excluded from version control via .gitignore.
FEATURE_AUDIT_ENABLED=false
FEATURE_AUDIT_LOG=logs/feature_audit.jsonl
FEATURE_AUDIT_MAX_BYTES=52428800
