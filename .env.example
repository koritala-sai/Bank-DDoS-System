
# Flask Server Configuration
FLASK_APP=backend/app.py
FLASK_ENV=development
FLASK_DEBUG=1
PORT=5000
SECRET_KEY=replace-with-a-random-secret-key

# MySQL Database Configuration
DB_HOST=localhost
DB_PORT=3306
DB_NAME=bank_ddos
DB_USER=your_mysql_username
DB_PASSWORD=your_mysql_password
DATABASE_URL=mysql+pymysql://your_mysql_username:your_url_encoded_password@localhost:3306/bank_ddos

# Network Interface & Monitoring Settings
NETWORK_INTERFACE=eth0
MONITOR_PROMISCUOUS=False

# Comma-separated list of protected/monitored subnets
# Example: 192.168.1.0/24 or 10.0.0.0/8,172.16.0.0/16
# If unset or empty, Inbound defaults to 0.0 (safe unconfigured behavior)
MONITORED_SUBNET=10.15.20.0/24

# Feature Audit Log (opt-in)
# Records flow metadata, 20 feature values, prediction, and confidence.
# Enable only during debugging or demo sessions, never in CI or automated tests.
# No packet payloads, application-layer content, or credentials are stored.
# The logs/ directory is excluded from version control via .gitignore.
FEATURE_AUDIT_ENABLED=false
FEATURE_AUDIT_LOG=logs/feature_audit.jsonl
FEATURE_AUDIT_MAX_BYTES=52428800
