# Flask Server Configuration
FLASK_APP=backend/app.py
FLASK_ENV=development
FLASK_DEBUG=1
PORT=5000
SECRET_KEY=change-this-to-a-secure-random-key-in-production

# MySQL Database Configuration
DB_HOST=localhost
DB_PORT=3306
DB_NAME=bank_ddos_db
DB_USER=root
DB_PASSWORD=your_password_here
DATABASE_URL=mysql+pymysql://root:your_password_here@localhost:3306/bank_ddos_db

# Network Interface & Monitoring Settings
NETWORK_INTERFACE=eth0
MONITOR_PROMISCUOUS=False
